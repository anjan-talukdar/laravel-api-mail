{
    "name": "anjan-talukdar/laravel-api-mail",
    "description": "Multi-provider HTTP API Mail driver and fluent message builder for Laravel (Hostinger Mail API integration with automated mailbox resolution).",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anjan Talukdar",
            "email": "developer.anjantalukdar@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/notifications": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/mail": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "AnjanTalukdar\\ApiMail\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AnjanTalukdar\\ApiMail\\ApiMailServiceProvider"
            ],
            "aliases": {
                "ApiMail": "AnjanTalukdar\\ApiMail\\Facades\\ApiMail"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
